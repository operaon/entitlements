# Serviço
NODE_ENV=development
SERVICE_NAME=operaon_entitlements
HOST=0.0.0.0
PORT=4770
TRUST_PROXY_HOPS=1

# Banco próprio do read model
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operaon_entitlements
DB_USER=dbadmin
DB_PASSWORD=
DB_SSL=false
DATABASE_URL=

# Banco legado usado somente pelo backfill dry-run
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=velyon_api
LEGACY_DB_USER=dbadmin
LEGACY_DB_PASSWORD=
LEGACY_DATABASE_URL=

# Autenticação dual; substituir pelo ambiente de execução em produção
SERVICE_API_KEY=entitlements-development-service-key
JWT_ALGORITHM=HS256
JWT_SECRET=entitlements-development-jwt-secret-change-me
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-api,operaon-identity,operaon-entitlements
JWT_PUBLIC_KEY=

# Operação
CORS_ORIGIN=*
REQUEST_TIMEOUT_MS=5000
MAX_QUERY_LIMIT=100
BACKFILL_WRITE_ENABLED=false
